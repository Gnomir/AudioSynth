# Copy to .env and fill in before running in anything but local dev.
PORT=4000
NODE_ENV=development

# Signs the session cookie. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional — used only by `npm run seed`, and only the first time it runs
# (it skips creating an admin if one already exists). If unset, a random
# password is generated and printed once.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# Optional — override the SQLite file location (default: database/app.sqlite)
# DB_PATH=./database/app.sqlite

# --- Freemius webhook (webapp/src/routes/webhooks.js) ---
# Required once a Freemius product exists. Freemius dashboard -> product
# settings -> "Secret Key" (verifies incoming webhooks are really from
# Freemius, via the x-signature header).
FREEMIUS_WEBHOOK_SECRET=

# The Cosine license-signing secret from `cargo xtask keygen new`
# (harmonic_synth/license/README.md). NEVER commit a real value here or
# anywhere else — generate it on an offline machine and set it only in the
# host's own env/secret store.
LICENSE_SIGNING_SECRET=

# Optional — path to a prebuilt `xtask` binary. If unset, the webhook shells
# out to `cargo xtask` instead, which requires the Rust toolchain and the
# harmonic_synth workspace on the same host as this webapp.
# XTASK_BIN=/opt/cosine/xtask
# XTASK_CWD=/opt/cosine/harmonic_synth
