# Copy to .env and fill in before running in anything but local dev.
PORT=4000
NODE_ENV=development

# Signs the session cookie. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional — used only by `npm run seed`, and only the first time it runs
# (it skips creating an admin if one already exists). If unset, a random
# password is generated and printed once.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# Optional — override the SQLite file location (default: database/app.sqlite)
# DB_PATH=./database/app.sqlite
