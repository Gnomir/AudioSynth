<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8E%9B%EF%B8%8F%3C/text%3E%3C/svg%3E">
<title>harmonic_core · live — Cosine</title>
<meta name="description" content="Cosine's DSP core compiled to WebAssembly, playing live in your browser — the byte-for-byte identical engine that ships in the VST3/CLAP plugin.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,600&family=JetBrains+Mono:wght@400;600&family=Spectral:wght@400;500&display=swap">
<style>
  :root {
    color-scheme: dark;
    --bg: #14161a;
    --bg-2: #0f1113;
    --panel: #1c2026;
    --panel-2: #23282f;
    --ink: #e9ebee;
    --prose: #a8aeb7;
    --dim: #8b929c;
    --faint: #737a84;
    --line: #2b3039;
    --amber: #e0a94a;
    --amber-dim: #8a6d34;
    --teal: #5cb4b2;
    --teal-dim: #3c6d6c;
    --red: #d8654a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.6 "Spectral", Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 640px; margin: 0 auto; padding: 3.5rem 1.25rem 4rem; }
  @media (max-width: 560px) { .wrap { padding: 2.25rem 1rem 3rem; } }

  .mono {
    font-family: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-variant-numeric: tabular-nums;
  }

  header { margin-bottom: 2rem; }
  .eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: .68rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 .7rem;
  }
  h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -.015em;
    margin: 0 0 .8rem;
    text-wrap: balance;
  }
  h1 em { font-style: italic; color: var(--amber); }
  .lede { color: var(--prose); font-size: .96rem; max-width: 46ch; margin: 0; }
  .lede code {
    font-family: "JetBrains Mono", monospace;
    font-size: .82em;
    color: var(--teal);
  }

  /* ---- the instrument ---- */
  .rig {
    background: linear-gradient(180deg, var(--panel), var(--panel-2));
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.35rem 1.4rem 1.5rem;
    margin-top: 1.75rem;
    box-shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 20px 50px -30px rgba(0,0,0,.7);
  }

  .powerrow { display: flex; align-items: center; gap: .9rem; margin-bottom: 1.1rem; }
  #power {
    font: 600 .92rem/1 "JetBrains Mono", monospace;
    letter-spacing: .04em;
    cursor: pointer;
    background: var(--amber);
    color: #1c1400;
    border: 0;
    border-radius: 7px;
    padding: .7rem 1.25rem;
    transition: opacity .15s, background .15s;
  }
  #power:hover { background: #eab857; }
  #power[disabled] { cursor: default; }
  #power.on { background: var(--teal); color: #06201f; }
  #power.err { background: var(--red); color: #200a06; }
  #scope {
    flex: 1;
    height: 40px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    display: block;
  }

  .group + .group { margin-top: 1.15rem; }
  .group-label {
    font-family: "JetBrains Mono", monospace;
    font-size: .62rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
    border-bottom: 1px solid var(--line);
    padding-bottom: .35rem;
    margin-bottom: .65rem;
  }

  .ctl {
    display: grid;
    grid-template-columns: 6.5rem 1fr 3.4rem;
    align-items: center;
    gap: .7rem;
    margin: .5rem 0;
  }
  .ctl > label {
    font-family: "JetBrains Mono", monospace;
    font-size: .8rem;
    color: var(--dim);
  }
  .ctl > output {
    font-family: "JetBrains Mono", monospace;
    font-size: .8rem;
    text-align: right;
    color: var(--teal);
  }
  input[type=range] {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 4px; border-radius: 2px;
    background: var(--panel-2);
    border: 1px solid var(--line);
    outline-offset: 3px;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 15px; height: 15px; border-radius: 50%;
    background: var(--amber); border: 2px solid var(--bg);
    cursor: pointer; margin-top: -1px;
  }
  input[type=range]::-moz-range-thumb {
    width: 13px; height: 13px; border-radius: 50%;
    background: var(--amber); border: 2px solid var(--bg); cursor: pointer;
  }
  select {
    font: .8rem/1 "JetBrains Mono", monospace;
    background: var(--bg-2); color: var(--ink);
    border: 1px solid var(--line); border-radius: 5px;
    padding: .4rem .5rem; width: 100%;
  }
  .seg { display: flex; gap: 4px; }
  .seg button {
    flex: 1;
    font: .74rem/1 "JetBrains Mono", monospace;
    letter-spacing: .02em;
    background: var(--bg-2); color: var(--dim);
    border: 1px solid var(--line); border-radius: 5px;
    padding: .42rem 0; cursor: pointer;
  }
  .seg button[aria-pressed=true] { background: var(--teal); color: #06201f; border-color: var(--teal); }

  /* ---- keyboard ---- */
  .keys {
    display: flex; gap: 3px;
    margin-top: 1.3rem;
    touch-action: none; user-select: none; -webkit-user-select: none;
  }
  .key {
    flex: 1; height: 4rem;
    background: linear-gradient(180deg, #e9ebef, #cfd3d9);
    color: #4a4f57;
    border-radius: 0 0 6px 6px;
    border: 1px solid #b9bec6; border-top: 0;
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: .4rem;
    font: .68rem/1 "JetBrains Mono", monospace;
    cursor: pointer;
  }
  .key.down { background: linear-gradient(180deg, var(--amber), #c98f31); color: #241800; }
  .hint {
    color: var(--faint); font-size: .8rem; margin: .9rem 0 0;
    font-family: "JetBrains Mono", monospace;
  }
  .hint kbd {
    background: var(--bg-2); border: 1px solid var(--line);
    border-radius: 3px; padding: .05rem .32rem; color: var(--dim);
  }

  footer {
    margin-top: 2rem;
    color: var(--faint);
    font-size: .84rem;
    line-height: 1.7;
  }
  footer code { font-family: "JetBrains Mono", monospace; color: var(--amber); }
  footer .fact { display: block; margin-top: .5rem; }
  a { color: var(--teal); text-decoration-color: var(--teal-dim); }
</style>
</head>
<body>
<div style="position:fixed;top:1rem;left:1rem;z-index:10">
  <a href="/" style="font:600 .78rem/1 'JetBrains Mono',monospace;letter-spacing:.04em;color:var(--dim);text-decoration:none;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:.5rem .8rem;display:inline-block">&larr; Cosine</a>
</div>
<div class="wrap">
  <header>
    <p class="eyebrow">wasm32 · no_std · zero dependencies</p>
    <h1>The same engine, running <em>in your browser</em>.</h1>
    <p class="lede">
      This is <code>harmonic_core</code> compiled to <code>wasm32-unknown-unknown</code> —
      the byte-for-byte identical DSP that ships in the VST3/CLAP plugin and
      cross-compiles to a Cortex-M board. Eight <code>Voice</code>s through the C
      ABI, playable as chords. Closed-form additive synthesis: the cost per
      sample is <code>Θ(log n)</code> no matter how many partials the tone has.
    </p>
  </header>

  <div class="rig">
    <div class="powerrow">
      <button id="power">power on</button>
      <canvas id="scope" width="440" height="80" aria-hidden="true"></canvas>
    </div>

    <div class="group">
      <div class="group-label">oscillator</div>
      <div class="ctl">
        <label for="wave">wave</label>
        <div class="seg" id="wave" role="group" aria-label="waveform">
          <button data-v="0" aria-pressed="true">geometric</button>
          <button data-v="1" aria-pressed="false">saw</button>
          <button data-v="2" aria-pressed="false">triangle</button>
        </div>
        <span></span>
      </div>
      <div class="ctl">
        <label for="brightness">brightness</label>
        <input type="range" id="brightness" min="0.02" max="0.965" step="0.001" value="0.86">
        <output id="brightness-v"></output>
      </div>
      <div class="ctl">
        <label for="partials">partials</label>
        <input type="range" id="partials" min="1" max="600" step="1" value="600">
        <output id="partials-v"></output>
      </div>
      <div class="ctl">
        <label for="formant">formant</label>
        <input type="range" id="formant" min="0" max="1" step="0.001" value="0">
        <output id="formant-v"></output>
      </div>
    </div>

    <div class="group">
      <div class="group-label">filter · zdf state-variable</div>
      <div class="ctl">
        <label for="fmode">mode</label>
        <select id="fmode">
          <option value="0">off</option>
          <option value="1" selected>low pass</option>
          <option value="2">band pass</option>
          <option value="3">high pass</option>
          <option value="4">notch</option>
        </select>
        <span></span>
      </div>
      <div class="ctl">
        <label for="cutoff">cutoff</label>
        <input type="range" id="cutoff" min="80" max="15000" step="1" value="6500">
        <output id="cutoff-v"></output>
      </div>
      <div class="ctl">
        <label for="resonance">resonance</label>
        <input type="range" id="resonance" min="0" max="1" step="0.001" value="0.18">
        <output id="resonance-v"></output>
      </div>
    </div>

    <div class="group">
      <div class="group-label">motion</div>
      <div class="ctl">
        <label for="lfoRate">lfo rate</label>
        <input type="range" id="lfoRate" min="0.1" max="12" step="0.01" value="5">
        <output id="lfoRate-v"></output>
      </div>
      <div class="ctl">
        <label for="lfoVibrato">→ vibrato</label>
        <input type="range" id="lfoVibrato" min="0" max="55" step="0.1" value="0">
        <output id="lfoVibrato-v"></output>
      </div>
      <div class="ctl">
        <label for="lfoCutoff">→ cutoff</label>
        <input type="range" id="lfoCutoff" min="0" max="3" step="0.01" value="0">
        <output id="lfoCutoff-v"></output>
      </div>
      <div class="ctl">
        <label>hq mode</label>
        <div class="seg" style="flex:1">
          <button id="hq" aria-pressed="false">2× oversample the nonlinear stages</button>
        </div>
        <span></span>
      </div>
    </div>

    <div class="keys" id="keys" aria-label="keyboard"></div>
    <p class="hint">mouse, touch, or the row <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> <kbd>F</kbd> <kbd>G</kbd> <kbd>H</kbd> <kbd>J</kbd> <kbd>K</kbd></p>
  </div>

  <footer>
    Note allocation, voice stealing and the amp attack/release are ~40 lines of
    JavaScript here — the core <code>Voice</code> has no envelope and no notion
    of polyphony, because that is the host's job, identical in this page and in
    a $30 Eurorack module.
    <span class="fact">
      This wasm build's verification render hashes to
      <code>0xc7f786d40586da75</code> — the exact same 64-bit value as the
      x86-64 and ARM builds. Nothing about the sound changes with the platform.
    </span>
  </footer>
</div>

<script id="wasm-b64" type="text/plain"></script>
<script nonce="<%= cspNonce %>">
(() => {
  const $ = (id) => document.getElementById(id);
  const b64 = $('wasm-b64').textContent.trim();
  const wasmBytes = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

  const NOTES = [ // C4..C5, C major
    ['A','C',261.63], ['S','D',293.66], ['D','E',329.63], ['F','F',349.23],
    ['G','G',392.00], ['H','A',440.00], ['J','B',493.88], ['K','C',523.25],
  ];

  let ctx, node, ex, scratch, running = false, atkC = 0, relC = 0, ageCounter = 0;
  let voices = [];              // { ptr, note, gate, gateTarget, age }
  const down = new Set();       // note ids currently held
  const fstate = { mode: 1, cutoff: 6500, res: 0.18 };
  const lstate = { rate: 5, vib: 0, cut: 0 };

  // ---- scope ----
  const scope = $('scope');
  const g2d = scope.getContext('2d');
  let scopeBuf = new Float32Array(256);
  function drawScope() {
    const w = scope.width, h = scope.height;
    g2d.fillStyle = '#0f1113'; g2d.fillRect(0, 0, w, h);
    g2d.strokeStyle = running ? '#e0a94a' : '#3a3f47';
    g2d.lineWidth = 1.5; g2d.beginPath();
    const n = scopeBuf.length;
    for (let i = 0; i < n; i++) {
      const x = (i / (n - 1)) * w;
      const y = h / 2 - scopeBuf[i] * (h / 2) * 0.9;
      i ? g2d.lineTo(x, y) : g2d.moveTo(x, y);
    }
    g2d.stroke();
    requestAnimationFrame(drawScope);
  }
  requestAnimationFrame(drawScope);

  // ---- controls (one patch, pushed to every voice) ----
  const patch = { brightness: 0.86, partials: 600, formant: 0, waveform: 0, hq: 0 };
  function send(name, value) { if (!ex) return; applyParam(name, value); }
  function applyParam(name, value) {
    switch (name) {
      case 'brightness': case 'partials': case 'formant': patch[name] = value; forEachVoice(setTone); break;
      case 'waveform': patch.waveform = value | 0; forEachVoice((p) => ex.harmonic_voice_set_waveform(p, patch.waveform)); break;
      case 'hq': patch.hq = value ? 1 : 0; forEachVoice((p) => ex.harmonic_voice_set_hq(p, patch.hq)); break;
      case 'fmode':      fstate.mode = value | 0; forEachVoice(pushFilter); break;
      case 'cutoff':     fstate.cutoff = value; forEachVoice(pushFilter); break;
      case 'resonance':  fstate.res = value; forEachVoice(pushFilter); break;
      case 'lfoRate':    lstate.rate = value; forEachVoice(pushLfo); break;
      case 'lfoVibrato': lstate.vib = value; forEachVoice(pushLfo); break;
      case 'lfoCutoff':  lstate.cut = value; forEachVoice(pushLfo); break;
    }
  }
  function forEachVoice(fn) { for (const v of voices) fn(v.ptr); }
  function setTone(p) {
    ex.harmonic_voice_set_rolloff(p, patch.brightness);
    ex.harmonic_voice_set_partial_limit(p, patch.partials);
    ex.harmonic_voice_set_formant(p, patch.formant);
  }
  function pushFilter(p) { ex.harmonic_voice_set_filter(p, fstate.mode, fstate.cutoff, fstate.res); }
  function pushLfo(p) { ex.harmonic_voice_set_lfo(p, lstate.rate, 0, 1, 0, lstate.vib, lstate.cut, 0); }

  function bindSlider(id, fmt, param, map = (x) => x) {
    const el = $(id), out = $(id + '-v');
    const fn = () => { const v = parseFloat(el.value); out.textContent = fmt(v); send(param, map(v)); };
    el.addEventListener('input', fn);
    return fn;
  }
  const sliders = [
    bindSlider('brightness', (v) => v.toFixed(2), 'brightness'),
    bindSlider('partials', (v) => String(v | 0), 'partials'),
    bindSlider('formant', (v) => v.toFixed(2), 'formant'),
    bindSlider('cutoff', (v) => (v | 0) + '', 'cutoff'),
    bindSlider('resonance', (v) => v.toFixed(2), 'resonance'),
    bindSlider('lfoRate', (v) => v.toFixed(1), 'lfoRate'),
    bindSlider('lfoVibrato', (v) => (v | 0) + 'c', 'lfoVibrato'),
    bindSlider('lfoCutoff', (v) => v.toFixed(2), 'lfoCutoff'),
  ];
  sliders.forEach((f) => f());

  const waveSeg = $('wave');
  waveSeg.addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    [...waveSeg.children].forEach((c) => c.setAttribute('aria-pressed', c === b));
    send('waveform', +b.dataset.v);
  });
  $('fmode').addEventListener('change', (e) => send('fmode', +e.target.value));
  $('hq').addEventListener('click', (e) => {
    const on = e.target.getAttribute('aria-pressed') !== 'true';
    e.target.setAttribute('aria-pressed', on);
    send('hq', on);
  });

  // ---- keyboard — polyphonic; each key is a note id (its index) ----
  const keysEl = $('keys');
  const byKey = new Map();
  NOTES.forEach(([code, name, hz], id) => {
    const d = document.createElement('div');
    d.className = 'key'; d.textContent = name;
    d.addEventListener('pointerdown', (e) => { d.setPointerCapture(e.pointerId); noteOn(id, hz, d); });
    d.addEventListener('pointerup', () => noteOff(id, d));
    d.addEventListener('pointercancel', () => noteOff(id, d));
    keysEl.appendChild(d);
    byKey.set(code, { id, hz, el: d });
  });
  function noteOn(id, hz, el) {
    if (!running || down.has(id)) return;
    down.add(id); el.classList.add('down');
    // free voice → oldest releasing → oldest overall
    let v = voices.find((x) => x.gateTarget === 0 && x.gate < 0.001)
         || voices.filter((x) => x.gateTarget === 0).sort((a, b) => a.age - b.age)[0]
         || voices.slice().sort((a, b) => a.age - b.age)[0];
    v.note = id; v.age = ++ageCounter; v.gateTarget = 1;
    ex.harmonic_voice_set_frequency(v.ptr, hz);
    if (v.gate < 0.001) ex.harmonic_voice_reset(v.ptr);
  }
  function noteOff(id, el) {
    if (!down.has(id)) return;
    down.delete(id); el.classList.remove('down');
    for (const v of voices) if (v.note === id && v.gateTarget === 1) { v.gateTarget = 0; v.note = null; }
  }
  addEventListener('keydown', (e) => {
    if (e.repeat || e.metaKey || e.ctrlKey) return;
    const k = byKey.get(e.key.toUpperCase());
    if (k) { e.preventDefault(); noteOn(k.id, k.hz, k.el); }
  });
  addEventListener('keyup', (e) => {
    const k = byKey.get(e.key.toUpperCase());
    if (k) noteOff(k.id, k.el);
  });
  addEventListener('blur', () => {
    down.forEach((id) => byKey.get(NOTES[id][0])?.el.classList.remove('down'));
    down.clear();
    voices.forEach((v) => { v.gateTarget = 0; v.note = null; });
  });

  // ---- audio ----
  $('power').addEventListener('click', async () => {
    if (running) return;
    const btn = $('power');
    btn.disabled = true; btn.textContent = 'booting…';
    try {
      ctx = new (window.AudioContext || window.webkitAudioContext)();
      const { instance } = await WebAssembly.instantiate(wasmBytes, {});
      ex = instance.exports;
      scratch = ex.harmonic_wasm_scratch();
      const pool = ex.harmonic_wasm_pool_size();
      for (let i = 0; i < pool; i++) {
        const ptr = ex.harmonic_wasm_voice_at(i);
        ex.harmonic_voice_init(ptr, ctx.sampleRate);
        ex.harmonic_voice_set_gain(ptr, 0.32); // headroom for chords
        voices.push({ ptr, note: null, gate: 0, gateTarget: 0, age: 0 });
      }
      atkC = 1 - Math.exp(-1 / (0.004 * ctx.sampleRate));
      relC = 1 - Math.exp(-1 / (0.13 * ctx.sampleRate));

      const BUF = 2048;
      const acc = new Float32Array(BUF * 2);
      const sp = ctx.createScriptProcessor(BUF, 0, 2);
      sp.onaudioprocess = (e) => {
        const L = e.outputBuffer.getChannelData(0);
        const R = e.outputBuffer.getChannelData(1);
        acc.fill(0);
        for (const v of voices) {
          if (v.gate < 1e-4 && v.gateTarget === 0) continue;
          ex.harmonic_voice_process(v.ptr, scratch, BUF);
          const src = new Float32Array(ex.memory.buffer, scratch, BUF * 2);
          let g = v.gate;
          const c = v.gateTarget > g ? atkC : relC;
          for (let i = 0; i < BUF; i++) {
            g += c * (v.gateTarget - g);
            acc[i * 2] += src[i * 2] * g;
            acc[i * 2 + 1] += src[i * 2 + 1] * g;
          }
          v.gate = g;
        }
        for (let i = 0; i < BUF; i++) { L[i] = acc[i * 2]; R[i] = acc[i * 2 + 1]; }
        for (let i = 0; i < 256; i++) scopeBuf[i] = acc[i * 16] || 0;
      };
      sp.connect(ctx.destination);
      node = sp;

      // push current UI state into every voice
      sliders.forEach((f) => f());
      send('waveform', +waveSeg.querySelector('[aria-pressed=true]').dataset.v);
      send('fmode', +$('fmode').value);

      running = true;
      btn.textContent = `● live · ${pool} voices`; btn.classList.add('on');
    } catch (err) {
      console.error(err);
      btn.textContent = 'wasm error'; btn.classList.add('err');
      btn.disabled = false;
    }
  });
})();
</script>


</body>
</html>
