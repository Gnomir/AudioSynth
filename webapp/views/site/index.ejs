<%- include('../partials/site-head', { title: title }) %>
<div class="bar">
  <div class="wrap">
    <span class="brand">Cosine <span class="prov" data-i18n="brand.prov"><%= cms.en['brand.prov'] %></span></span>
    <nav id="site-nav">
      <a href="#tune" data-i18n="tune.kick"><%= cms.en['tune.kick'] %></a>
      <a href="#listen" data-i18n="listen.kick"><%= cms.en['listen.kick'] %></a>
      <a href="#audit" data-i18n="audit.kick"><%= cms.en['audit.kick'] %></a>
      <a href="#pricing" data-i18n="nav.pricing"><%= cms.en['nav.pricing'] %></a>
      <% if (user) { %>
        <a href="/account" data-i18n="nav.account"><%= cms.en['nav.account'] %></a>
      <% } else { %>
        <a href="/login" data-i18n="nav.login"><%= cms.en['nav.login'] %></a>
      <% } %>
    </nav>
    <div class="seg" role="group" aria-label="Language / Мова">
      <button type="button" data-lang="en" aria-pressed="true">EN</button>
      <button type="button" data-lang="uk" aria-pressed="false">УКР</button>
    </div>
    <button type="button" class="icon-btn" id="theme" aria-label="Toggle theme" title="Theme">◐</button>
    <button type="button" class="icon-btn menu-btn" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
  </div>
</div>

<div class="wrap"><%- include('../partials/flash') %></div>

<header class="hero">
  <div class="wrap grid">
    <div>
      <p class="eyebrow" data-i18n="hero.eyebrow"><%= cms.en['hero.eyebrow'] %></p>
      <h1 data-i18n-html="hero.h1"><%- cms.en['hero.h1'] %></h1>
      <p class="sub" data-i18n-html="hero.sub"><%- cms.en['hero.sub'] %></p>
      <div class="cta-row">
        <a class="btn primary" href="/demo" data-i18n="hero.cta.demo"><%= cms.en['hero.cta.demo'] %></a>
        <a class="btn" href="#pricing" data-i18n="hero.cta.pricing"><%= cms.en['hero.cta.pricing'] %></a>
        <a class="btn" href="https://github.com/Gnomir/AudioSynth" target="_blank" rel="noopener">GitHub</a>
      </div>
      <p class="formhint" data-i18n-html="hero.proof" style="margin-top:1rem"><%- cms.en['hero.proof'] %></p>
    </div>

    <div class="panel" id="demo">
      <p class="label"><span data-i18n="panel.label"><%= cms.en['panel.label'] %></span><span class="ok" id="bl" data-i18n="panel.bandlimited"><%= cms.en['panel.bandlimited'] %></span></p>
      <div class="screen">
        <canvas id="cv" width="900" height="520" aria-label="Live harmonic spectrum of the closed-form oscillator"></canvas>
      </div>
      <div class="sliders">
        <div class="sld">
          <label for="s-b" data-i18n="panel.brightness"><%= cms.en['panel.brightness'] %></label>
          <input id="s-b" type="range" min="0" max="1000" value="770" aria-label="Brightness">
          <output id="o-b">0.60</output>
        </div>
        <div class="sld">
          <label for="s-p" data-i18n="panel.partials"><%= cms.en['panel.partials'] %></label>
          <input id="s-p" type="range" min="4" max="96" value="30" aria-label="Partials">
          <output id="o-p">30</output>
        </div>
        <div class="sld">
          <label for="s-f" data-i18n="panel.formant"><%= cms.en['panel.formant'] %></label>
          <input id="s-f" type="range" min="0" max="1000" value="440" aria-label="Formant">
          <output id="o-f">off</output>
        </div>
      </div>
      <div class="cost" id="cost"></div>
      <p class="note" data-i18n="panel.note"><%= cms.en['panel.note'] %></p>
    </div>
  </div>
</header>

<div class="trustbar">
  <div class="wrap">
    <span data-i18n="trustbar.1"><%= cms.en['trustbar.1'] %></span>
    <span data-i18n="trustbar.2"><%= cms.en['trustbar.2'] %></span>
    <span data-i18n="trustbar.3"><%= cms.en['trustbar.3'] %></span>
    <span data-i18n="trustbar.4"><%= cms.en['trustbar.4'] %></span>
    <span data-i18n="trustbar.5"><%= cms.en['trustbar.5'] %></span>
    <span data-i18n="trustbar.6"><%= cms.en['trustbar.6'] %></span>
  </div>
</div>

<main>
<section id="why">
  <div class="wrap">
    <p class="kick" data-i18n="why.kick"><%= cms.en['why.kick'] %></p>
    <div class="four">
      <div class="card">
        <h3 data-i18n="why.1.h"><%= cms.en['why.1.h'] %></h3>
        <p data-i18n-html="why.1.p"><%- cms.en['why.1.p'] %></p>
      </div>
      <div class="card">
        <h3 data-i18n="why.2.h"><%= cms.en['why.2.h'] %></h3>
        <p data-i18n-html="why.2.p"><%- cms.en['why.2.p'] %></p>
      </div>
      <div class="card">
        <h3 data-i18n="why.3.h"><%= cms.en['why.3.h'] %></h3>
        <p data-i18n-html="why.3.p"><%- cms.en['why.3.p'] %></p>
      </div>
      <div class="card">
        <h3 data-i18n="why.4.h"><%= cms.en['why.4.h'] %></h3>
        <p data-i18n-html="why.4.p"><%- cms.en['why.4.p'] %></p>
      </div>
    </div>
    <p class="formhint" style="margin-top:1.25rem" data-i18n-html="how.p3"><%- cms.en['how.p3'] %></p>
  </div>
</section>

<section id="audience">
  <div class="wrap narrow">
    <p class="kick" data-i18n="audience.kick"><%= cms.en['audience.kick'] %></p>
    <h2 data-i18n="audience.h"><%= cms.en['audience.h'] %></h2>
    <ul>
      <li data-i18n="audience.1"><%= cms.en['audience.1'] %></li>
      <li data-i18n="audience.2"><%= cms.en['audience.2'] %></li>
      <li data-i18n="audience.3"><%= cms.en['audience.3'] %></li>
    </ul>
    <p class="formhint" data-i18n="audience.note"><%= cms.en['audience.note'] %></p>
  </div>
</section>

<section id="serum">
  <div class="wrap narrow">
    <p class="kick" data-i18n="serum.kick"><%= cms.en['serum.kick'] %></p>
    <h2 data-i18n="serum.h"><%= cms.en['serum.h'] %></h2>
    <p class="lead" data-i18n-html="serum.lead"><%- cms.en['serum.lead'] %></p>
    <div class="feat">
      <div><h4 data-i18n="serum.1.h"><%= cms.en['serum.1.h'] %></h4><p data-i18n-html="serum.1.p"><%- cms.en['serum.1.p'] %></p></div>
      <div><h4 data-i18n="serum.2.h"><%= cms.en['serum.2.h'] %></h4><p data-i18n-html="serum.2.p"><%- cms.en['serum.2.p'] %></p></div>
      <div><h4 data-i18n="serum.3.h"><%= cms.en['serum.3.h'] %></h4><p data-i18n-html="serum.3.p"><%- cms.en['serum.3.p'] %></p></div>
      <div><h4 data-i18n="serum.4.h"><%= cms.en['serum.4.h'] %></h4><p data-i18n-html="serum.4.p"><%- cms.en['serum.4.p'] %></p></div>
    </div>

    <h3 data-i18n="cmp.h" style="margin-top:2.2rem"><%= cms.en['cmp.h'] %></h3>
    <div class="tablewrap">
      <table>
        <thead><tr><th data-i18n="cmp.th1"><%= cms.en['cmp.th1'] %></th><th data-i18n="cmp.th2"><%= cms.en['cmp.th2'] %></th></tr></thead>
        <tbody>
          <tr><td data-i18n="cmp.r1a"><%= cms.en['cmp.r1a'] %></td><td data-i18n-html="cmp.r1b"><%- cms.en['cmp.r1b'] %></td></tr>
          <tr><td data-i18n="cmp.r2a"><%= cms.en['cmp.r2a'] %></td><td data-i18n="cmp.r2b"><%= cms.en['cmp.r2b'] %></td></tr>
          <tr><td data-i18n="cmp.r3a"><%= cms.en['cmp.r3a'] %></td><td data-i18n-html="cmp.r3b"><%- cms.en['cmp.r3b'] %></td></tr>
          <tr><td data-i18n="cmp.r4a"><%= cms.en['cmp.r4a'] %></td><td data-i18n="cmp.r4b"><%= cms.en['cmp.r4b'] %></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section id="tune">
  <div class="wrap narrow">
    <p class="kick" data-i18n="tune.kick"><%= cms.en['tune.kick'] %></p>
    <h2 data-i18n="tune.h"><%= cms.en['tune.h'] %></h2>
    <p class="lead" data-i18n-html="feat.tune.p"><%- cms.en['feat.tune.p'] %></p>
    <div class="callout">
      <p data-i18n-html="tune.proof"><%- cms.en['tune.proof'] %></p>
    </div>
  </div>
</section>

<section id="shot">
  <div class="wrap narrow">
    <p class="kick" data-i18n="shot.kick"><%= cms.en['shot.kick'] %></p>
    <h2 data-i18n="shot.h"><%= cms.en['shot.h'] %></h2>
    <figure class="shot">
      <img src="/images/reaper-screenshot.png" alt="Cosine plugin editor running live in REAPER v7.79" loading="lazy">
      <figcaption data-i18n="shot.caption"><%= cms.en['shot.caption'] %></figcaption>
    </figure>
    <p style="text-align:center;margin-top:1.5rem">
      <a class="btn primary" href="/demo" data-i18n="hero.cta.demo"><%= cms.en['hero.cta.demo'] %></a>
    </p>
  </div>
</section>

<section id="audit">
  <div class="wrap">
    <p class="kick" data-i18n="audit.kick"><%= cms.en['audit.kick'] %></p>
    <h2 data-i18n="audit.h"><%= cms.en['audit.h'] %></h2>
    <p class="lead" data-i18n-html="audit.sub"><%- cms.en['audit.sub'] %></p>
    <div class="auditgrid">
      <% for (let i = 1; i <= 9; i++) { %>
      <div>
        <p class="v"><%= cms.en['audit.' + i + '.v'] %></p>
        <p data-i18n="audit.<%= i %>.p"><%= cms.en['audit.' + i + '.p'] %></p>
      </div>
      <% } %>
    </div>
    <p class="formhint" style="margin-top:1rem" data-i18n-html="audit.foot"><%- cms.en['audit.foot'] %></p>
  </div>
</section>

<section id="listen">
  <div class="wrap">
    <p class="kick" data-i18n="listen.kick"><%= cms.en['listen.kick'] %></p>
    <h2 data-i18n="listen.h"><%= cms.en['listen.h'] %></h2>
    <p class="lead" data-i18n="listen.p"><%= cms.en['listen.p'] %></p>

    <h3 data-i18n="presets.h" style="margin-top:2rem"><%= cms.en['presets.h'] %></h3>
    <p class="formhint" data-i18n="presets.p" style="margin:0 0 1rem"><%= cms.en['presets.p'] %></p>
    <div class="listen presets">
      <div>
        <p class="lbl" data-i18n="presets.1.label"><%= cms.en['presets.1.label'] %></p>
        <audio controls preload="none" src="/audio/deep-sub.wav"></audio>
      </div>
      <div>
        <p class="lbl" data-i18n="presets.2.label"><%= cms.en['presets.2.label'] %></p>
        <audio controls preload="none" src="/audio/bright-saw-lead.wav"></audio>
      </div>
      <div>
        <p class="lbl" data-i18n="presets.3.label"><%= cms.en['presets.3.label'] %></p>
        <audio controls preload="none" src="/audio/warm-analog-pad.wav"></audio>
      </div>
      <div>
        <p class="lbl" data-i18n="presets.4.label"><%= cms.en['presets.4.label'] %></p>
        <audio controls preload="none" src="/audio/dx-bell.wav"></audio>
      </div>
    </div>

    <h3 data-i18n="listen.tech.kick" style="margin-top:2rem"><%= cms.en['listen.tech.kick'] %></h3>
    <div class="listen">
      <div>
        <p class="lbl" data-i18n="listen.1.label"><%= cms.en['listen.1.label'] %></p>
        <audio controls preload="none" src="/audio/brightness-sweep.wav"></audio>
      </div>
      <div>
        <p class="lbl" data-i18n="listen.2.label"><%= cms.en['listen.2.label'] %></p>
        <audio controls preload="none" src="/audio/unison-pad.wav"></audio>
      </div>
      <div>
        <p class="lbl" data-i18n="listen.3.label"><%= cms.en['listen.3.label'] %></p>
        <audio controls preload="none" src="/audio/character-progression.wav"></audio>
      </div>
    </div>
    <p style="margin-top:1.25rem">
      <a class="btn primary" href="/demo" data-i18n="listen.cta"><%= cms.en['listen.cta'] %></a>
    </p>
  </div>
</section>

<section id="pricing">
  <div class="wrap narrow">
    <p class="kick" data-i18n="price.kick"><%= cms.en['price.kick'] %></p>
    <h2 data-i18n="price.h"><%= cms.en['price.h'] %></h2>
    <div class="price">
      <div class="tier">
        <p class="tname">Core</p>
        <p class="amt" data-i18n="price.core.amt"><%= cms.en['price.core.amt'] %></p>
        <p class="was" data-i18n="price.core.was"><%= cms.en['price.core.was'] %></p>
        <ul>
          <li data-i18n="price.core.1"><%= cms.en['price.core.1'] %></li>
          <li data-i18n="price.core.2"><%= cms.en['price.core.2'] %></li>
          <li data-i18n="price.core.3"><%= cms.en['price.core.3'] %></li>
          <li data-i18n="price.core.4"><%= cms.en['price.core.4'] %></li>
          <li data-i18n="price.core.5"><%= cms.en['price.core.5'] %></li>
        </ul>
        <a class="btn primary tier-cta" href="https://github.com/Gnomir/AudioSynth/releases/tag/v0.1.0-core" target="_blank" rel="noopener" data-i18n="price.core.cta"><%= cms.en['price.core.cta'] %></a>
      </div>
      <div class="tier hi">
        <p class="tname">Studio <span class="badge" data-i18n="price.studio.badge"><%= cms.en['price.studio.badge'] %></span></p>
        <p class="amt" data-i18n-html="price.studio.amt"><%- cms.en['price.studio.amt'] %></p>
        <p class="was" data-i18n="price.studio.was"><%= cms.en['price.studio.was'] %></p>
        <ul>
          <li data-i18n="price.studio.1"><%= cms.en['price.studio.1'] %></li>
          <li data-i18n="price.studio.2"><%= cms.en['price.studio.2'] %></li>
          <li data-i18n-html="price.studio.3"><%- cms.en['price.studio.3'] %></li>
          <li data-i18n="price.studio.4"><%= cms.en['price.studio.4'] %></li>
          <li data-i18n="price.studio.5"><%= cms.en['price.studio.5'] %></li>
          <li data-i18n="price.studio.6"><%= cms.en['price.studio.6'] %></li>
        </ul>
        <a class="btn primary tier-cta" href="#notify" data-i18n="price.studio.cta"><%= cms.en['price.studio.cta'] %></a>
      </div>
    </div>
    <p class="formhint" data-i18n="price.foot"><%= cms.en['price.foot'] %></p>
    <h3 data-i18n="price.eng.h"><%= cms.en['price.eng.h'] %></h3>
    <p data-i18n-html="price.eng.p"><%- cms.en['price.eng.p'] %></p>
  </div>
</section>

<section id="limits">
  <div class="wrap narrow">
    <p class="kick" data-i18n="lim.kick"><%= cms.en['lim.kick'] %></p>
    <h2 data-i18n="lim.h"><%= cms.en['lim.h'] %></h2>
    <div class="honest">
      <ul>
        <li data-i18n-html="lim.1"><%- cms.en['lim.1'] %></li>
        <li data-i18n-html="lim.2"><%- cms.en['lim.2'] %></li>
        <li data-i18n-html="lim.3"><%- cms.en['lim.3'] %></li>
        <li data-i18n-html="lim.4"><%- cms.en['lim.4'] %></li>
        <li data-i18n-html="lim.5"><%- cms.en['lim.5'] %></li>
        <li data-i18n-html="lim.6"><%- cms.en['lim.6'] %></li>
      </ul>
    </div>
    <p class="formhint" data-i18n-html="lim.foot"><%- cms.en['lim.foot'] %></p>
  </div>
</section>

<section id="faq">
  <div class="wrap narrow">
    <p class="kick" data-i18n="faq.kick"><%= cms.en['faq.kick'] %></p>
    <h2 data-i18n="faq.h"><%= cms.en['faq.h'] %></h2>
    <% faqs.forEach(function (f, i) { %>
    <details>
      <summary data-i18n="faq.q<%= i + 1 %>"><%= f.question_en %></summary>
      <p data-i18n-html="faq.a<%= i + 1 %>"><%- f.answer_en %></p>
    </details>
    <% }) %>
  </div>
</section>

<section id="features">
  <div class="wrap narrow">
    <p class="kick" data-i18n="feat.kick"><%= cms.en['feat.kick'] %></p>
    <h2 data-i18n="feat.h"><%= cms.en['feat.h'] %></h2>
    <ul>
      <li><strong data-i18n="feat.osc.h"><%= cms.en['feat.osc.h'] %></strong> — <span data-i18n-html="feat.osc.p"><%- cms.en['feat.osc.p'] %></span></li>
      <li><strong data-i18n="feat.char.h"><%= cms.en['feat.char.h'] %></strong> — <span data-i18n="feat.char.p"><%= cms.en['feat.char.p'] %></span></li>
      <li><strong data-i18n="feat.fm.h"><%= cms.en['feat.fm.h'] %></strong> — <span data-i18n="feat.fm.p"><%= cms.en['feat.fm.p'] %></span></li>
      <li><strong data-i18n="feat.filt.h"><%= cms.en['feat.filt.h'] %></strong> — <span data-i18n-html="feat.filt.p"><%- cms.en['feat.filt.p'] %></span></li>
      <li><strong data-i18n="feat.voice.h"><%= cms.en['feat.voice.h'] %></strong> — <span data-i18n-html="feat.voice.p"><%- cms.en['feat.voice.p'] %></span></li>
      <li><strong data-i18n="feat.expr.h"><%= cms.en['feat.expr.h'] %></strong> — <span data-i18n="feat.expr.p"><%= cms.en['feat.expr.p'] %></span></li>
      <li><strong data-i18n="feat.mod.h"><%= cms.en['feat.mod.h'] %></strong> — <span data-i18n="feat.mod.p"><%= cms.en['feat.mod.p'] %></span></li>
      <li><strong data-i18n="feat.work.h"><%= cms.en['feat.work.h'] %></strong> — <span data-i18n="feat.work.p"><%= cms.en['feat.work.p'] %></span></li>
      <li><strong data-i18n="feat.see.h"><%= cms.en['feat.see.h'] %></strong> — <span data-i18n="feat.see.p"><%= cms.en['feat.see.p'] %></span></li>
    </ul>
    <p class="formhint"><a href="/handbook" data-i18n="final.cta.handbook"><%= cms.en['final.cta.handbook'] %></a></p>
  </div>
</section>

<section id="engine">
  <div class="wrap narrow">
    <p class="kick" data-i18n="eng.kick"><%= cms.en['eng.kick'] %></p>
    <h2 data-i18n="eng.h"><%= cms.en['eng.h'] %></h2>
    <p class="lead" data-i18n-html="eng.lead"><%- cms.en['eng.lead'] %></p>
    <ul>
      <li data-i18n-html="eng.li1"><%- cms.en['eng.li1'] %></li>
      <li data-i18n-html="eng.li2"><%- cms.en['eng.li2'] %></li>
      <li data-i18n-html="eng.li3"><%- cms.en['eng.li3'] %></li>
      <li data-i18n-html="eng.li4"><%- cms.en['eng.li4'] %></li>
      <li data-i18n-html="eng.li5"><%- cms.en['eng.li5'] %></li>
    </ul>
    <p data-i18n-html="eng.p"><%- cms.en['eng.p'] %></p>
  </div>
</section>
</main>

<div class="final">
  <div class="wrap narrow">
    <h2 data-i18n="final.h"><%= cms.en['final.h'] %></h2>
    <p class="sub" data-i18n="final.sub"><%= cms.en['final.sub'] %></p>
    <p class="cta-row" style="justify-content:center">
      <a class="btn primary" href="https://github.com/Gnomir/AudioSynth/releases/tag/v0.1.0-core" target="_blank" rel="noopener" data-i18n="final.download"><%= cms.en['final.download'] %></a>
    </p>
    <p class="formhint" id="notify-hint" data-i18n="final.hint" style="margin-top:1.5rem"><%= cms.en['final.hint'] %></p>
    <form class="notify" id="notify">
      <input type="email" id="notify-email" name="email" placeholder="you@studio.com" aria-label="Email address" required>
      <button class="btn" type="submit" data-i18n="final.notify"><%= cms.en['final.notify'] %></button>
    </form>
    <div class="cta-row" style="margin-top:1.5rem">
      <a class="btn" href="/handbook" data-i18n="final.cta.handbook"><%= cms.en['final.cta.handbook'] %></a>
      <a class="btn" href="https://github.com/Gnomir/AudioSynth" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</div>

<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <strong data-i18n="foot.product"><%= cms.en['foot.product'] %></strong>
        <a href="#features" data-i18n="nav.features"><%= cms.en['nav.features'] %></a>
        <a href="#pricing" data-i18n="nav.pricing"><%= cms.en['nav.pricing'] %></a>
        <a href="/handbook" data-i18n="foot.handbook"><%= cms.en['foot.handbook'] %></a>
        <a href="/demo" data-i18n="foot.demo"><%= cms.en['foot.demo'] %></a>
      </div>
      <div>
        <strong data-i18n="foot.technical"><%= cms.en['foot.technical'] %></strong>
        <a href="/monograph" data-i18n="foot.monograph"><%= cms.en['foot.monograph'] %></a>
